# Expense Tracker — environment variables
#
# Copy this file to .env.local and fill in the values from your Supabase project
# (Dashboard → Project Settings → API). Restart `npm run dev` afterwards.
#
# Both values are safe to expose in the browser: your data is protected by
# Row Level Security policies in the database, not by hiding this key.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
